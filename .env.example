# Display Refill — environment reference (context/development-setup.md).
#
# Nothing reads a root .env. Copy the relevant block into:
#   apps/admin/.env.local        admin/API (Next.js)
#   workers/scan-worker/.env     scan worker
# iOS uses apps/ios/DisplayRefill/Config/Local.xcconfig (publishable values only).
#
# Local values: run `npx supabase status` after `npm run db:start`.
# Secret values stay empty here. Never commit real keys; never prefix a secret
# with NEXT_PUBLIC_ (that ships it to the browser).

# ---------------------------------------------------------------------------
# Admin/API — apps/admin/.env.local
# ---------------------------------------------------------------------------

# Public (inlined into the browser bundle). Publishable key only; RLS still applies.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Origin only (no path); used for CSRF and redirect checks.
APP_ORIGIN=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Scan worker — workers/scan-worker/.env
# ---------------------------------------------------------------------------

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# postgres:// or postgresql:// URL (local: DB_URL from `supabase status`).
DATABASE_URL=
# Only "mock" is accepted until a provider is selected (feature 09).
VISION_PROVIDER=mock
VISION_MODEL=
VISION_API_KEY=
# Whole days, at least 1.
SCAN_IMAGE_RETENTION_DAYS=90
SCAN_METADATA_RETENTION_DAYS=365
LOG_LEVEL=info
