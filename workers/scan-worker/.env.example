# scan-worker configuration. Copy to workers/scan-worker/.env (git-ignored).
# Server/worker only: never copy these into the admin client, iOS app or logs.
# Local values come from `supabase status` once local Supabase runs (feature 02).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Only "mock" is accepted until a real provider is benchmarked and approved.
# Mock results are synthetic; the app labels them as test analysis.
VISION_PROVIDER=mock
# mixed | good | poor_alignment | occluded | invalid | duplicate_ids | unknown_id | missing_slot
VISION_MOCK_SCENARIO=mixed
VISION_MODEL=
VISION_API_KEY=
SCAN_IMAGE_RETENTION_DAYS=90
SCAN_METADATA_RETENTION_DAYS=365
LOG_LEVEL=info
# Process capacity; DB independently caps active jobs at two per store.
WORKER_CONCURRENCY=2
# One bounded cleanup invocation. No automatic destructive schedule is enabled.
CLEANUP_BATCH_SIZE=100
# Retention values above are proposals requiring approval before production.
# SCAN_METADATA_RETENTION_DAYS is reserved policy documentation; metadata is NEVER deleted.
