# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# monorepo build output
dist/
**/.next/

# local secrets (examples are committed)
!.env.example
!**/.env.example

# iOS / Xcode
apps/ios/**/*.xcodeproj/
apps/ios/**/xcuserdata/
apps/ios/**/DerivedData/
apps/ios/**/.build/
apps/ios/**/.swiftpm/
apps/ios/DisplayRefill/Config/Local.xcconfig

