# Admin/API configuration. Copy to apps/admin/.env.local (git-ignored).
# Local values come from `supabase status` once local Supabase runs (feature 02).

# Public (inlined into the browser bundle). Publishable key only; RLS still applies.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Origin only (no path); used for CSRF and redirect checks.
APP_ORIGIN=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info