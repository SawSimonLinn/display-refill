// Public app configuration. Never put service-role keys, database URLs or
// vision provider keys here: everything in this file ships inside the app.
// xcconfig treats "//" as a comment, so URLs use "/$()/" to split the slashes.

API_BASE_URL = http:/$()/localhost:3000
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY =

// Developer overrides (git-ignored). Copy Local.example.xcconfig to Local.xcconfig.
#include? "Local.xcconfig"
